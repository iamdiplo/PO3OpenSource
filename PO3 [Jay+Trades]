calcMidpoint(float h, float l, float o, float c) =>
    float lh = math.log(h), float ll = math.log(l), float lo = math.log(o), float lc = math.log(c)
    float uw = lh - math.max(lo, lc), float lw = math.min(lo, lc) - ll
    float bs = math.abs(lc - lo)
    float lmid = math.max(uw, lw) > bs ? (uw > lw ? lh - uw / 2 : ll + lw / 2) : (lh + ll) / 2
    math.exp(lmid)

f_short_time(int t, int tf_mins) =>
    string res = ""
    if not na(t)
        if tf_mins < 1440
            res := str.format_time(t, "HH", i_timezone) + "\n" + str.format_time(t, "mm", i_timezone)
        else if tf_mins < 10080
            int nominal_t = t
            if tf_mins == 1440
                nominal_t += 12 * 60 * 60 * 1000
            
            int d = dayofweek(nominal_t, i_timezone)
            if d == 1
                res := "Sun"
            else if d == 2
                res := "Mon"
            else if d == 3
                res := "Tue"
            else if d == 4
                res := "Wed"
            else if d == 5
                res := "Thu"
            else if d == 6
                res := "Fri"
            else
                res := "Sat"
        else
            int nominal_t = t
            if tf_mins >= 10080
                nominal_t += 12 * 60 * 60 * 1000 // Push weekly Sunday open to Monday
            
            res := str.format_time(nominal_t, "dd", i_timezone) + "\n" + str.format_time(nominal_t, "MMM", i_timezone)
    res

