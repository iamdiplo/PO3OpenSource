f_custom_psp(array<float> m_o, array<float> m_h, array<float> m_l, array<float> m_c, array<int> m_t, 
             array<float> o_t2, array<float> h_t2, array<float> l_t2, array<float> c_t2, array<int> t_t2,
             array<float> o_t3, array<float> h_t3, array<float> l_t3, array<float> c_t3, array<int> t_t3,
             array<float> o_t4, array<float> h_t4, array<float> l_t4, array<float> c_t4, array<int> t_t4,
             bool inv2, bool inv3, bool inv4, string g_bias, string psp_trigger, int tf_mins) =>
    int sz = array.size(m_h)
    array<int> psp = array.new<int>(math.max(sz, 1), 0)
    bool require_pivot = psp_trigger != "PC"
    if sz >= 3
        for i = 1 to sz - 2
            float h_i = array.get(m_h, i)
            float l_i = array.get(m_l, i)
            if na(h_i) or na(l_i)
                continue
            bool is_ph = h_i > array.get(m_h, i + 1) and h_i > array.get(m_h, i - 1)
            bool is_pl = l_i < array.get(m_l, i + 1) and l_i < array.get(m_l, i - 1)
            if not require_pivot or is_ph or is_pl
                bool b1 = array.get(m_c, i) >= array.get(m_o, i)
                bool crack = false
                int t_i = array.get(m_t, i)

                if ticker2 != "SKIP_SYMBOL"
                    int idx2 = f_find_time_idx(t_t2, t_i, tf_mins)
                    if idx2 != -1
                        bool b2 = inv2 ? (array.get(c_t2, idx2) <= array.get(o_t2, idx2)) : (array.get(c_t2, idx2) >= array.get(o_t2, idx2))
                        if b1 != b2
                            crack := true
                if ticker3 != "SKIP_SYMBOL"
                    int idx3 = f_find_time_idx(t_t3, t_i, tf_mins)
                    if idx3 != -1
                        bool b3 = inv3 ? (array.get(c_t3, idx3) <= array.get(o_t3, idx3)) : (array.get(c_t3, idx3) >= array.get(o_t3, idx3))
                        if b1 != b3
                            crack := true
                if ticker4 != "SKIP_SYMBOL"
                    int idx4 = f_find_time_idx(t_t4, t_i, tf_mins)
                    if idx4 != -1
                        bool b4 = inv4 ? (array.get(c_t4, idx4) <= array.get(o_t4, idx4)) : (array.get(c_t4, idx4) >= array.get(o_t4, idx4))
                        if b1 != b4
                            crack := true

                if crack
                    bool mark_bear = require_pivot ? is_ph : not b1
                    bool mark_bull = require_pivot ? is_pl : b1
                    if mark_bear and (g_bias == "Neutral" or g_bias == "Bearish")
                        array.set(psp, i, 1)
                    if mark_bull and (g_bias == "Neutral" or g_bias == "Bullish")
                        array.set(psp, i, 2)
    psp

