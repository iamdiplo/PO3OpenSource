f_opposite_model_at_index(bool current_bearish, int idx, array<float> jy_h, array<float> jy_l, array<float> jy_c) =>
    bool found = false
    int ref_idx = idx + 1
    if idx >= 0 and ref_idx < array.size(jy_h)
        float rh = array.get(jy_h, ref_idx)
        float rl = array.get(jy_l, ref_idx)
        float ch = array.get(jy_h, idx)
        float cl = array.get(jy_l, idx)
        float cc = array.get(jy_c, idx)
        bool ok = not na(rh) and not na(rl) and not na(ch) and not na(cl) and not na(cc)
        if ok
            if current_bearish
                found := (cl < rl and cc > rl)
            else
                found := (ch > rh and cc < rh)
    found

