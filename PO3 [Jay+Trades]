f_custom_smt(array<float> m_h, array<float> m_l, array<int> m_t, array<int> m_ht, array<int> m_lt,
             array<float> h_t2, array<float> l_t2, array<int> t_t2,
             array<float> h_t3, array<float> l_t3, array<int> t_t3,
             array<float> h_t4, array<float> l_t4, array<int> t_t4,
             bool inv2, bool inv3, bool inv4, string g_bias, string tf_name, int draw_count, int startOff, int tf_mins) =>
    string latest_smt = "None"
    int sz = array.size(m_h)
    if draw_count >= 2 and sz >= 2
        for p = 0 to draw_count - 2
            int older_idx = draw_count - 1 - p
            int newer_idx = draw_count - 2 - p
            if older_idx < sz and newer_idx >= 0
                float m_curr_h = array.get(m_h, newer_idx), float m_curr_l = array.get(m_l, newer_idx)
                float m_prev_h = array.get(m_h, older_idx), float m_prev_l = array.get(m_l, older_idx)
                if not na(m_curr_h) and not na(m_prev_h)
                    int main_curr_time = array.get(m_t, newer_idx)
                    int main_prev_time = array.get(m_t, older_idx)

                    bool main_lower_low   = m_curr_l < m_prev_l
                    bool main_higher_low  = m_curr_l > m_prev_l
                    bool main_higher_high = m_curr_h > m_prev_h
                    bool main_lower_high  = m_curr_h < m_prev_h

                    bool is_bull = false
                    string bull_pair_name = ""
                    bool is_bear = false
                    string bear_pair_name = ""

                    if g_bias == "Neutral" or g_bias == "Bullish"
                        if not is_bull and ticker2 != "SKIP_SYMBOL"
                            int c2i = f_find_time_idx(t_t2, main_curr_time, tf_mins), int c2p = f_find_time_idx(t_t2, main_prev_time, tf_mins)
                            if c2i != -1 and c2p != -1
                                float a_l = inv2 ? -array.get(h_t2, c2i) : array.get(l_t2, c2i)
                                float a_pl = inv2 ? -array.get(h_t2, c2p) : array.get(l_t2, c2p)
                                if (main_lower_low and a_l > a_pl) or (main_higher_low and a_l < a_pl)
                                    is_bull := true, bull_pair_name := ticker2
                        if not is_bull and ticker3 != "SKIP_SYMBOL"
                            int c3i = f_find_time_idx(t_t3, main_curr_time, tf_mins), int c3p = f_find_time_idx(t_t3, main_prev_time, tf_mins)
                            if c3i != -1 and c3p != -1
                                float a_l = inv3 ? -array.get(h_t3, c3i) : array.get(l_t3, c3i)
                                float a_pl = inv3 ? -array.get(h_t3, c3p) : array.get(l_t3, c3p)
                                if (main_lower_low and a_l > a_pl) or (main_higher_low and a_l < a_pl)
                                    is_bull := true, bull_pair_name := ticker3
                        if not is_bull and ticker4 != "SKIP_SYMBOL"
                            int c4i = f_find_time_idx(t_t4, main_curr_time, tf_mins), int c4p = f_find_time_idx(t_t4, main_prev_time, tf_mins)
                            if c4i != -1 and c4p != -1
                                float a_l = inv4 ? -array.get(h_t4, c4i) : array.get(l_t4, c4i)
                                float a_pl = inv4 ? -array.get(h_t4, c4p) : array.get(l_t4, c4p)
                                if (main_lower_low and a_l > a_pl) or (main_higher_low and a_l < a_pl)
                                    is_bull := true, bull_pair_name := ticker4

                    if g_bias == "Neutral" or g_bias == "Bearish"
                        if not is_bear and ticker2 != "SKIP_SYMBOL"
                            int c2i = f_find_time_idx(t_t2, main_curr_time, tf_mins), int c2p = f_find_time_idx(t_t2, main_prev_time, tf_mins)
                            if c2i != -1 and c2p != -1
                                float a_h = inv2 ? -array.get(l_t2, c2i) : array.get(h_t2, c2i)
                                float a_ph = inv2 ? -array.get(l_t2, c2p) : array.get(h_t2, c2p)
                                if (main_higher_high and a_h < a_ph) or (main_lower_high and a_h > a_ph)
                                    is_bear := true, bear_pair_name := ticker2
                        if not is_bear and ticker3 != "SKIP_SYMBOL"
                            int c3i = f_find_time_idx(t_t3, main_curr_time, tf_mins), int c3p = f_find_time_idx(t_t3, main_prev_time, tf_mins)
                            if c3i != -1 and c3p != -1
                                float a_h = inv3 ? -array.get(l_t3, c3i) : array.get(h_t3, c3i)
                                float a_ph = inv3 ? -array.get(l_t3, c3p) : array.get(h_t3, c3p)
                                if (main_higher_high and a_h < a_ph) or (main_lower_high and a_h > a_ph)
                                    is_bear := true, bear_pair_name := ticker3
                        if not is_bear and ticker4 != "SKIP_SYMBOL"
                            int c4i = f_find_time_idx(t_t4, main_curr_time, tf_mins), int c4p = f_find_time_idx(t_t4, main_prev_time, tf_mins)
                            if c4i != -1 and c4p != -1
                                float a_h = inv4 ? -array.get(l_t4, c4i) : array.get(h_t4, c4i)
                                float a_ph = inv4 ? -array.get(l_t4, c4p) : array.get(h_t4, c4p)
                                if (main_higher_high and a_h < a_ph) or (main_lower_high and a_h > a_ph)
                                    is_bear := true, bear_pair_name := ticker4

                    if is_bull and i_smt_hide_invalid
                        float inv_level_bull = math.min(m_curr_l, m_prev_l)
                        if older_idx > 0
                            for k = 0 to older_idx - 1
                                float val = array.get(m_l, k)
                                if not na(val) and val < inv_level_bull
                                    is_bull := false
                                    break
                                    
                    if is_bear and i_smt_hide_invalid
                        float inv_level_bear = math.max(m_curr_h, m_prev_h)
                        if older_idx > 0
                            for k = 0 to older_idx - 1
                                float val = array.get(m_h, k)
                                if not na(val) and val > inv_level_bear
                                    is_bear := false
                                    break

                    if is_bull or is_bear
                        int panel_x_prev = bar_index + startOff + p * (i_width + i_buffer) + i_width / 2
                        int panel_x_curr = bar_index + startOff + (p + 1) * (i_width + i_buffer) + i_width / 2
                        if is_bull
                            if i_smt_show
                                g_smt_lines.push(line.new(panel_x_prev, m_prev_l, panel_x_curr, m_curr_l, color=i_smt_bull_col, width=i_smt_width, style=get_smt_style()))
                            if i_smt_show_chart
                                string clean_pair = str.contains(bull_pair_name, ":") ? array.get(str.split(bull_pair_name, ":"), 1) : bull_pair_name
                                string disp = i_smt_lbl_mode == "Emoji" ? "⚡" : clean_pair + " " + tf_name
                                string tooltip = clean_pair + " • " + tf_name + " • 2 Candle SMT • Bullish"
                                int wick_t_curr = f_snap_time(array.get(m_lt, newer_idx))
                                int wick_t_prev = f_snap_time(array.get(m_lt, older_idx))
                                int mid_t = int(math.avg(wick_t_prev, wick_t_curr))
                                float mid_p = math.avg(m_prev_l, m_curr_l)
                                g_smt_lines.push(line.new(wick_t_prev, m_prev_l, wick_t_curr, m_curr_l, xloc=xloc.bar_time, color=i_smt_bull_col, width=i_smt_width, style=get_smt_style()))
                                g_timelabels.push(label.new(mid_t, mid_p, disp, xloc=xloc.bar_time, color=transparent, textcolor=i_smt_bull_col, style=label.style_label_up, size=i_smt_lbl_size, text_font_family=font.family_default, tooltip=tooltip))
                            if p == draw_count - 2
                                latest_smt := "Bull"
                        else if is_bear
                            if i_smt_show
                                g_smt_lines.push(line.new(panel_x_prev, m_prev_h, panel_x_curr, m_curr_h, color=i_smt_bear_col, width=i_smt_width, style=get_smt_style()))
                            if i_smt_show_chart
                                string clean_pair = str.contains(bear_pair_name, ":") ? array.get(str.split(bear_pair_name, ":"), 1) : bear_pair_name
                                string disp = i_smt_lbl_mode == "Emoji" ? "⚡" : clean_pair + " " + tf_name
                                string tooltip = clean_pair + " • " + tf_name + " • 2 Candle SMT • Bearish"
                                int wick_t_curr = f_snap_time(array.get(m_ht, newer_idx))
                                int wick_t_prev = f_snap_time(array.get(m_ht, older_idx))
                                int mid_t = int(math.avg(wick_t_prev, wick_t_curr))
                                float mid_p = math.avg(m_prev_h, m_curr_h)
                                g_smt_lines.push(line.new(wick_t_prev, m_prev_h, wick_t_curr, m_curr_h, xloc=xloc.bar_time, color=i_smt_bear_col, width=i_smt_width, style=get_smt_style()))
                                g_timelabels.push(label.new(mid_t, mid_p, disp, xloc=xloc.bar_time, color=transparent, textcolor=i_smt_bear_col, style=label.style_label_down, size=i_smt_lbl_size, text_font_family=font.family_default, tooltip=tooltip))
                            if p == draw_count - 2
                                latest_smt := "Bear"
    latest_smt

