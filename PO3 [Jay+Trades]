                    float c3h = array.get(jy_h, c3_idx), float c3l = array.get(jy_l, c3_idx)
                    f_jy_panel_label(c3_x, bearish ? c3h : c3l, "C3", state_col, bearish)
                    
                if show_follow_through and i_jy_show_c4 and c4_idx >= 0 and c4_idx < jy_target_dc
                    int c4_x = bar_index + jy_target_off + (jy_target_dc - 1 - c4_idx) * (i_width + i_buffer) + i_width / 2
                    float c4h = array.get(jy_h, c4_idx), float c4l = array.get(jy_l, c4_idx)
                    f_jy_panel_label(c4_x, bearish ? c4h : c4l, "C4", state_col, bearish)

        setups_drawn += 1

    if last_cisd_event_bar == bar_index and last_cisd_event_bar != last_cisd_alerted_bar
        cisd_alert_cond := true
        last_cisd_alerted_bar := last_cisd_event_bar

    bool any_smt = (final_smt_1 != "None" or final_smt_2 != "None" or final_smt_3 != "None")
    if cisd_alert_cond and any_smt
