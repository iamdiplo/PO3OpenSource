    if isValidHTF(tf1_mins)
        [c2_trig1, c2_t1] = f_check_c2_alert(h1_arr, l1_arr, c1_arr, t1_arr, final_smt_1, final_psp_1)
        if c2_trig1 and c2_t1 != last_htf1_t
            htf1_alert := true
            last_htf1_t := c2_t1

    if isValidHTF(tf2_mins)
        [c2_trig2, c2_t2] = f_check_c2_alert(h2_arr, l2_arr, c2_arr, t2_arr, final_smt_2, final_psp_2)
        if c2_trig2 and c2_t2 != last_htf2_t
            htf2_alert := true
            last_htf2_t := c2_t2

    if isValidHTF(tf3_mins)
        [c2_trig3, c2_t3] = f_check_c2_alert(h3_arr, l3_arr, c3_arr, t3_arr, final_smt_3, final_psp_3)
        if c2_trig3 and c2_t3 != last_htf3_t
            htf3_alert := true
            last_htf3_t := c2_t3

    // UI Dashboard Blocks...
    if i_vl_show
        array<float> vl_h = i_vl_tf == "TF1" ? h1_arr : i_vl_tf == "TF2" ? h2_arr : h3_arr
        array<float> vl_l = i_vl_tf == "TF1" ? l1_arr : i_vl_tf == "TF2" ? l2_arr : l3_arr
        array<int>   vl_t = i_vl_tf == "TF1" ? t1_arr : i_vl_tf == "TF2" ? t2_arr : t3_arr
        int vl_max = i_vl_tf == "TF1" ? i_maxshow1 : i_vl_tf == "TF2" ? i_maxshow2 : i_maxshow3
        
        int vl_sz = array.size(vl_t)
        if vl_sz > 0
            int limit_idx = math.min(vl_sz - 1, vl_max - 1)
            if limit_idx >= 0
                float global_top = -10e10
                float global_bot = 10e10
                
                for i = 0 to limit_idx
                    float ch_h = array.get(vl_h, i)
                    float ch_l = array.get(vl_l, i)
                    if not na(ch_h) and ch_h > global_top
                        global_top := ch_h
                    if not na(ch_l) and ch_l < global_bot
                        global_bot := ch_l

                if global_top == -10e10
                    global_top := high
                if global_bot == 10e10
                    global_bot := low

                for i = 0 to limit_idx
                    int ht = array.get(vl_t, i)
                    
                    if not na(ht)
                        bool is_dup = false
                        if i > 0 and ht == array.get(vl_t, i - 1)
                            is_dup := true
                        
                        if not is_dup
                            array.push(jy_vlines, line.new(ht, global_bot, ht, global_top, xloc=xloc.bar_time, color=i_vl_col, style=get_line_style2(i_vl_sty), width=i_vl_wid))
                            if i_vl_lbl
                                array.push(jy_vlabels, label.new(ht, global_top, formatTime(ht), xloc=xloc.bar_time, color=transparent, textcolor=i_vl_col, style=label.style_label_down, size=i_vl_lbl_size, text_font_family=font.family_default))

