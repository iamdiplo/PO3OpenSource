f_get_group_id(int t, int target_mins) =>
    int group_id = 0
    if target_mins == 10080
        group_id := year(t, i_timezone) * 100 + weekofyear(t, i_timezone)
    else if target_mins > 10080
        group_id := year(t, i_timezone) * 100 + month(t, i_timezone)
    else
        // Align anchor to the active daily exchange open (eff_hr : eff_min)
        int h_tz = hour(t, i_timezone)
        int m_tz = minute(t, i_timezone)
        
        int adjusted_hr = (h_tz - eff_hr + 24) % 24
        int shift_mins = (adjusted_hr * 60) + (m_tz - eff_min)
        
        if shift_mins < 0
            shift_mins += 1440
            
        group_id := t - ((shift_mins % target_mins) * 60000)
    group_id

