            float c3h_for_fail = array.get(jy_h, c3_idx), float c3l_for_fail = array.get(jy_l, c3_idx)
            float c4h = array.get(jy_h, c4_idx), float c4l = array.get(jy_l, c4_idx)
            bool level_fail_c4 = bearish ? c4h > c3h_for_fail : c4l < c3l_for_fail
            bool opposite_fail_c4 = c4_idx >= 1 ? f_opposite_model_at_index(bearish, c4_idx, jy_h, jy_l, jy_c) : false
            fail_c4 := level_fail_c4 or opposite_fail_c4

        color state_col = fail_c3 ? i_jy_fail3_col : fail_c4 ? i_jy_fail4_col : i_jy_valid_col
        bool show_follow_through = not fail_c3

        if not display_model
            continue

        if setups_drawn < i_jy_history + 1
            if not na(jy_target_off) and not na(jy_target_dc)
                if i_jy_show_c1 and c1_idx < jy_target_dc
                    int c1_x = bar_index + jy_target_off + (jy_target_dc - 1 - c1_idx) * (i_width + i_buffer) + i_width / 2
                    f_jy_panel_label(c1_x, bearish ? c1h : c1l, "C1", state_col, bearish)
    
                if i_jy_show_c2 and c2_idx < jy_target_dc
