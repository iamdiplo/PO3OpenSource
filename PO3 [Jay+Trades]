        string smt_pairs_str = t2_clean
        if t3_clean != ""
            smt_pairs_str := smt_pairs_str != "" ? smt_pairs_str + " · " + t3_clean : t3_clean
        if t4_clean != ""
            smt_pairs_str := smt_pairs_str != "" ? smt_pairs_str + " · " + t4_clean : t4_clean
            
        if smt_pairs_str == ""
            smt_pairs_str := "--"

        string tf_str = ""
        if i_mode == "Universal Model" or i_mode == "Manual Sequence"
            tf_str := str.lower(tf1_name) + "-" + str.lower(tf2_name) + "-" + str.lower(tf3_name)
            if tf3_name == "" 
                tf_str := str.lower(tf1_name) + "-" + str.lower(tf2_name)
        else if i_mode == "7H Profiling"
            tf_str := str.lower(tf1_name) + "-" + str.lower(tf2_name) + "-" + str.lower(tf3_name)
        else if i_mode == "Quarterly Profiling"
            tf_str := str.lower(tf1_name) + "-" + str.lower(tf2_name) + "-" + str.lower(tf3_name)
        else if i_mode == "CRT Model"
            tf_str := str.lower(tf1_name)
            
        string profile_str = i_mode 
        
        string c_pair = syminfo.ticker
        if str.contains(syminfo.ticker, ":")
            c_pair := array.get(str.split(syminfo.ticker, ":"), 1)

        string d1_bot = smt_pairs_str + " ← SMT Assets"

        table.cell(dash, 0, 0, profile_str, text_color=c_cyan_teal, text_size=big_size, text_font_family=dash_font, text_halign=text.align_right)
        table.cell(dash, 1, 0, " ┃ ", text_color=c_sep, text_size=big_size, text_font_family=dash_font, text_halign=text.align_center)
        table.cell(dash, 2, 0, tf_str, text_color=c_pink, text_size=big_size, text_font_family=dash_font, text_halign=text.align_center)
        table.cell(dash, 3, 0, " ┃ ", text_color=c_sep, text_size=big_size, text_font_family=dash_font, text_halign=text.align_center)
        table.cell(dash, 4, 0, c_pair, text_color=c_cyan_teal, text_size=big_size, text_font_family=dash_font, text_halign=text.align_left)
        
        table.cell(dash, 0, 1, d1_bot, text_color=c_sep, text_size=sm_size, text_font_family=dash_font, text_halign=text.align_center)
