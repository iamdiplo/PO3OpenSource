drawBlock(array<float> os, array<float> hs, array<float> ls, array<float> cs, array<int> ts, array<int> psp_arr, int startOff, int n, HTF_Colors col, string g_bias, int tf_mins) =>
    int avail = array.size(os)
    int draw_count = math.min(n, avail)
    xs1 = array.new<int>(), xs2 = array.new<int>(), chs = array.new<float>(), cls = array.new<float>(), cos = array.new<float>(), ccs = array.new<float>()
    float blockHigh = 0.0

    int slot = 0
    while slot < draw_count
        int idx = draw_count - 1 - slot
        if idx < avail
            float co = os.get(idx), float ch = hs.get(idx), float cl = ls.get(idx), float cc = cs.get(idx), int ct = ts.get(idx)
            int psp_status = idx < array.size(psp_arr) ? psp_arr.get(idx) : 0
            if not na(co)
                [x1, x2, cvh, cvl] = drawCandle(co, ch, cl, cc, ct, slot, startOff, col, psp_status, tf_mins)
                xs1.push(x1), xs2.push(x2), chs.push(ch), cls.push(cl), cos.push(co), ccs.push(cc)
                if ch > blockHigh
                    blockHigh := ch
        slot += 1

    int drawn = xs1.size()
    
    string latest_psp = "None"
    if array.size(psp_arr) > 0
        for k = 0 to math.min(array.size(psp_arr) - 1, 5)
            int p = psp_arr.get(k)
            if p == 1
                latest_psp := "Bear"
                break
            else if p == 2
                latest_psp := "Bull"
                break

    string latest_sweep = "None"
    if drawn >= 2
        for j = 1 to math.min(drawn - 1, 2)
            int c_idx = drawn - j
            int p_idx = drawn - j - 1
            float ph_l = chs.get(p_idx), float pl_l = cls.get(p_idx)
            float nh_l = chs.get(c_idx), float nl_l = cls.get(c_idx), float nc_l = ccs.get(c_idx)
            if nh_l > ph_l and nc_l < ph_l
                latest_sweep := "Bear"
                break
            if nl_l < pl_l and nc_l > pl_l
                latest_sweep := "Bull"
                break

    if i_mid_show and drawn >= 2
        for i = 0 to drawn - 2
            float mid = calcMidpoint(chs.get(i), cls.get(i), cos.get(i), ccs.get(i))
            g_mids.push(line.new(xs1.get(i) + i_width / 2, mid, xs1.get(i+1) + i_width / 2, mid, color=i_mid_color, style=line.style_dotted, width=1))

    if i_sweep_show and drawn >= 2
        for i = 0 to drawn - 2
            float ph = chs.get(i), float pl = cls.get(i), float nh = chs.get(i+1), float nl = cls.get(i+1), float nc = ccs.get(i+1)
            int sx1 = xs1.get(i) + i_width / 2
            int sx2 = (i + 2 < drawn) ? (xs1.get(i+2) + i_width / 2) : (xs1.get(i+1) + i_width / 2)
            if nh > ph and nc < ph
                g_sweeps.push(line.new(sx1, ph, sx2, ph, color=i_sweep_color, width=1))
            if nl < pl and nc > pl
                g_sweeps.push(line.new(sx1, pl, sx2, pl, color=i_sweep_color, width=1))

    if i_fvg_show and drawn >= 3
        for i = 0 to drawn - 3
            float h1f = chs.get(i), float l1f = cls.get(i), float h3f = chs.get(i+2), float l3f = cls.get(i+2)
            int fx1 = xs1.get(i), int fx2 = xs2.get(i+2)
            bool is_bull_fvg = l3f > h1f
            bool is_bear_fvg = h3f < l1f
            if is_bull_fvg and (g_bias == "Neutral" or g_bias == "Bullish")
                g_fvgs.push(box.new(fx1, l3f, fx2, h1f, bgcolor=i_fvg_color, border_color=transparent))
            if is_bear_fvg and (g_bias == "Neutral" or g_bias == "Bearish")
                g_fvgs.push(box.new(fx1, l1f, fx2, h3f, bgcolor=i_fvg_color, border_color=transparent))

    if i_vi_show and drawn >= 2
        for i = 0 to drawn - 2
            float o1 = cos.get(i), float c1 = ccs.get(i)
            float o2 = cos.get(i+1), float c2 = ccs.get(i+1)
            
            float bodyTop1 = math.max(o1, c1)
            float bodyBot1 = math.min(o1, c1)
            float bodyTop2 = math.max(o2, c2)
            float bodyBot2 = math.min(o2, c2)
            
            int vx1 = xs1.get(i)
            int vx2 = xs2.get(i+1)
            
            bool is_bull_vi = bodyTop1 < bodyBot2
            bool is_bear_vi = bodyBot1 > bodyTop2
            
            if is_bull_vi and (g_bias == "Neutral" or g_bias == "Bullish")
                g_vis.push(box.new(vx1, bodyBot2, vx2, bodyTop1, bgcolor=i_vi_bull_col, border_color=i_vi_border))
            if is_bear_vi and (g_bias == "Neutral" or g_bias == "Bearish")
                g_vis.push(box.new(vx1, bodyBot1, vx2, bodyTop2, bgcolor=i_vi_bear_col, border_color=i_vi_border))

    int totalW  = draw_count * i_width + math.max(0, draw_count - 1) * i_buffer
    [bar_index + startOff + totalW / 2, blockHigh, startOff + totalW + i_htfgap, draw_count, latest_psp, latest_sweep]

