f_htf_pivots(array<float> main_h, array<float> main_l, array<int> main_t, array<int> main_ht, array<int> main_lt, int left, int right) =>
    array<float> out_h    = array.new<float>()
    array<int>   out_hidx = array.new<int>()
    array<int>   out_htc  = array.new<int>()
    array<int>   out_htw  = array.new<int>()
    array<float> out_l    = array.new<float>()
    array<int>   out_lidx = array.new<int>()
    array<int>   out_ltc  = array.new<int>()
    array<int>   out_ltw  = array.new<int>()
    int sz = array.size(main_h)
    if sz >= left + right + 1
        for idx = right to sz - 1 - left
            float ph = array.get(main_h, idx)
            bool is_ph = true
            for p = 1 to right
                if ph <= array.get(main_h, idx - p)
                    is_ph := false
                    break
            if is_ph
                for p = 1 to left
                    if ph <= array.get(main_h, idx + p)
                        is_ph := false
                        break
            if is_ph
                array.push(out_h, ph)
                array.push(out_hidx, idx)
                array.push(out_htc, array.get(main_t, idx))
                array.push(out_htw, array.get(main_ht, idx))

            float pl = array.get(main_l, idx)
            bool is_pl = true
            for p = 1 to right
                if pl >= array.get(main_l, idx - p)
                    is_pl := false
                    break
            if is_pl
                for p = 1 to left
                    if pl >= array.get(main_l, idx + p)
                        is_pl := false
                        break
            if is_pl
                array.push(out_l, pl)
                array.push(out_lidx, idx)
                array.push(out_ltc, array.get(main_t, idx))
                array.push(out_ltw, array.get(main_lt, idx))
    [out_h, out_hidx, out_htc, out_htw, out_l, out_lidx, out_ltc, out_ltw]

